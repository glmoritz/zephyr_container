{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Zephyr: Set Active Project",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/zephyr-project.sh",
        "set"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Zephyr: Build Active Project",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/zephyr-project.sh",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Zephyr: Flash Active Project",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/zephyr-project.sh",
        "flash",
        "/dev/ttyACM0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Zephyr: Monitor (miniterm)",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "serial.tools.miniterm",
        "--raw",
        "/dev/ttyACM0",
        "115200"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Zephyr: Monitor (miniterm, Dedicated Panel)",
      "type": "shell",
      "command": "python",
      "args": [
        "-m",
        "serial.tools.miniterm",
        "--raw",
        "/dev/ttyACM0",
        "115200"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Zephyr: Flash then Monitor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Zephyr: Flash Active Project",
        "Zephyr: Monitor (miniterm, Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Debug: OpenOCD (Active Project)",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "/workspace/boards/esp32s3-zephyr.cfg",
        "-c",
        "init; reset halt; esp appimage_offset 0x0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "."
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Listening on port 3333 for gdb connections"
          }
        }
      ]
    },
    {
      "label": "Debug: OpenOCD (Active Project, Dedicated Panel)",
      "type": "shell",
      "command": "openocd",
      "args": [
        "-f",
        "/workspace/boards/esp32s3-zephyr.cfg",
        "-c",
        "init; reset halt; esp appimage_offset 0x0"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "."
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "Listening on port 3333 for gdb connections"
          }
        }
      ]
    },
    {
      "label": "Debug: Restart OpenOCD (Active Project)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Debug: Stop OpenOCD",
        "Debug: OpenOCD (Active Project, Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Debug: Flash then OpenOCD (Active Project)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Zephyr: Flash Active Project",
        "Debug: Stop OpenOCD",
        "Debug: OpenOCD (Active Project, Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Debug: Stop OpenOCD",
      "type": "shell",
      "command": "pkill -f 'openocd' || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Debug: Prepare ESP32-S3 Session",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Zephyr: Build Active Project",
        "Debug: OpenOCD (Active Project)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Build",
      "type": "shell",
      "command": "west",
      "args": [
        "build",
        "-p",
        "auto",
        "-b",
        "native_sim/native/64",
        "-d",
        "build-sim"
      ],
      "options": {
        "cwd": "${workspaceFolder}/projects/hello_eink",
        "env": {
          "ZEPHYR_BASE": "/opt/toolchains/zephyr"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Native sim: Setup network",
      "type": "shell",
      "command": "./scripts/setup_net_sim.sh",
      "options": {
        "cwd": "${workspaceFolder}/projects/hello_eink"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Native sim: Run + Monitor (Dedicated Panel)",
      "type": "shell",
      "command": "./scripts/run_native_sim.sh",
      "args": [
        "-uart_stdinout"
      ],
      "options": {
        "cwd": "${workspaceFolder}/projects/hello_eink"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": {
            "regexp": "."
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".",
            "endsPattern": "uart:~\\$"
          }
        }
      ]
    },
    {
      "label": "Native sim: Build then Run + Monitor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Native sim: Build",
        "Native sim: Setup network",
        "Native sim: Run + Monitor (Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Build + Setup network",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Native sim: Build",
        "Native sim: Setup network"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Restart + Monitor (Dedicated Panel)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Native sim: Stop native sim",
        "Native sim: Setup network",
        "Native sim: Run + Monitor (Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Build then Restart + Monitor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Native sim: Build",
        "Native sim: Restart + Monitor (Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Telnet Shell (Dedicated Panel)",
      "type": "shell",
      "command": "telnet",
      "args": [
        "192.0.2.1",
        "23"
      ],
      "options": {
        "cwd": "${workspaceFolder}/projects/hello_eink"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Native sim: Setup network + Telnet Shell",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Native sim: Setup network",
        "Native sim: Telnet Shell (Dedicated Panel)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Native sim: Stop native sim",
      "type": "shell",
      "command": "pkill -f 'build-sim/zephyr/zephyr.exe' || true",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}